# Generate .env with: ./gradlew initLocalEnv
# This template contains no actual password or JWT secret.

# Docker Compose PostgreSQL; Spring uses the same values.
POSTGRES_DB=hospital
POSTGRES_USER=hospital
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=15432

# Generated locally; never commit the actual .env file.
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_TTL_SECONDS=1800

# Frontend development server (HTTP, default port 8443).
CORS_ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# Backend listens on this computer only.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
